# I-MODE Plus Service & Maintenance

# Browser / tooling noise
debug.log
*.log

# Data exports — these contain real customer records, never publish them
I-MODE_Service_Backup_*.json
imode-seed-*.sql

# Credentials — the app stores the Supabase URL and anon key in localStorage,
# so nothing should ever land here. Kept as a guard.
.env
.env.*
*.pem
*.key

# OS / editor
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Dependencies (this project has none, kept as a guard)
node_modules/

# Claude Code local machine settings — not part of the app
.claude/settings.local.json
